<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            mycolor: {
              green: '#1DB954',
              dark: '#121212',
              light: '#282828'
            }
          }
        }
      }
    }
  </script>

</head>

<%- include("partials/navbar", { page: '/'}) %> 
<body class="bg-black min-h-screen flex items-center justify-center">
  <main class="container mx-auto p-4 max-w-md">
    <div class="bg-dark text-white p-8 rounded-lg shadow-lg">
      <h1 class="text-3xl font-bold mb-10 text-center">Sign up</h1>
      
      <form method="POST" action="/register" class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="block text-sm font-medium">Email address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            class="w-full px-4 py-3 bg-light border border-gray-600 rounded focus:outline-none focus:border-green focus:ring-1 focus:ring-green"
          />
        </div>
        
        <div class="space-y-2">
          <label for="username" class="block text-sm font-medium">Create a username</label>
          <input 
            type="text" 
            id="username" 
            name="username" 
            required 
            class="w-full px-4 py-3 bg-light border border-gray-600 rounded focus:outline-none focus:border-green focus:ring-1 focus:ring-green"
          />
        </div>
        
        <div class="space-y-2">
          <label for="password" class="block text-sm font-medium">Create a password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            class="w-full px-4 py-3 bg-light border border-gray-600 rounded focus:outline-none focus:border-green focus:ring-1 focus:ring-green"
          />
        </div>
        
        <div class="space-y-2">
          <label for="confirmPassword" class="block text-sm font-medium">Confirm your password</label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            required 
            class="w-full px-4 py-3 bg-light border border-gray-600 rounded focus:outline-none focus:border-green focus:ring-1 focus:ring-green"
          />
        </div>
        

        <button 
        type="submit" 
        class="w-full py-3 bg-mycolor-green text-black font-bold rounded-full"
      >
        Sign Up
      </button>
      
      <div class="border-t border-gray-700 my-6"></div>
      
      <div class="text-center">
        <p class="text-gray-400">Already have an account? <a href="/login" class="text-white hover:underline font-bold">Log in</a></p>
      </div>
      
      <% if (errorMessage) { %>
        <div class="mt-6 p-3 bg-red-900 text-white rounded text-sm flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= errorMessage %></span>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>